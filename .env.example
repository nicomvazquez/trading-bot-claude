# Base de datos
DB_HOST=db
DB_PORT=5432
DB_NAME=trading_bot
DB_USER=trading_bot
DB_PASSWORD=poné-acá-una-contraseña-larga-y-única

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Bybit
# "demo" (Demo Trading: datos y liquidez reales, fondos virtuales) mientras
# validamos el bot; "mainnet" recien cuando pasemos a operar con dinero real.
# La API key de demo se crea desde tu cuenta normal de bybit.com activando
# el toggle "Demo Trading" antes de generarla (no es una cuenta aparte).
BYBIT_ENV=demo
BYBIT_API_KEY=
BYBIT_API_SECRET=

# App
# Interfaz donde escucha el dashboard: 0.0.0.0 = toda la red (servidor privado), 127.0.0.1 = solo este equipo
APP_BIND=0.0.0.0
APP_PORT=8080

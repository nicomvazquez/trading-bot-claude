# Base de datos
DB_HOST=db
DB_PORT=5432
DB_NAME=trading_bot
DB_USER=trading_bot
DB_PASSWORD=poné-acá-una-contraseña-larga-y-única

# Bybit
# Entorno con el que arranca el proceso ("demo" | "mainnet"). Una vez arriba, el entorno
# REALMENTE activo se elige y se cambia desde el dashboard (Configuración → Conexión con
# Bybit → Cambiar a...), sin tocar este archivo ni reiniciar: esta variable solo importa
# la primera vez, antes de que exista esa elección guardada.
BYBIT_ENV=demo

# Credenciales de Demo Trading (datos y liquidez reales, fondos virtuales). Se crean desde tu
# cuenta normal de bybit.com activando el toggle "Demo Trading" antes de generarlas (no es una
# cuenta aparte).
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Credenciales de MAINNET (dinero real). Dejalas vacías mientras solo operás en demo: el
# selector de entorno del dashboard no deja pasar a mainnet si faltan.
BYBIT_MAINNET_API_KEY=
BYBIT_MAINNET_API_SECRET=

# App
# Interfaz donde escucha el dashboard: 0.0.0.0 = toda la red (servidor privado), 127.0.0.1 = solo este equipo
APP_BIND=0.0.0.0
APP_PORT=8080
# Zona horaria en la que se muestran las horas (todo se guarda en UTC)
APP_TIMEZONE=America/Argentina/Buenos_Aires

# Alertas por Telegram (kill-switch, errores de la operativa en vivo). Vacíos = alertas desactivadas.
# Se configuran desde Configuración → Alertas (hay instrucciones ahí para conseguir estos dos valores).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
